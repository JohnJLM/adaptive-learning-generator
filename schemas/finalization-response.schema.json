{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-learning-generator.local/schemas/finalization-response.schema.json",
  "title": "FinalizationResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "generationId", "finalizedAt", "approvedProfileIds"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "generationId": { "type": "string", "minLength": 1 },
    "finalizedAt": { "type": "string", "format": "date-time" },
    "approvedProfileIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
