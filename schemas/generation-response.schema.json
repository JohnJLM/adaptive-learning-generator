{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-learning-generator.local/schemas/generation-response.schema.json",
  "title": "GenerationResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "generationId", "mode", "title", "generalObjective", "materials"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "generationId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["mock", "live"] },
    "generatedAt": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "generalObjective": { "type": "string", "minLength": 1 },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profileId", "profileName", "adaptationSummary", "content"],
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "profileName": { "type": "string", "minLength": 1 },
          "adaptationSummary": { "type": "string", "minLength": 1 },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["introduction", "explanation", "activity", "checkQuestion"],
            "properties": {
              "introduction": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 },
              "checkQuestion": { "type": "string", "minLength": 1 },
              "activity": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "instructions", "expectedEvidence"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "instructions": { "type": "string", "minLength": 1 },
                  "expectedEvidence": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
