{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-learning-generator.local/schemas/generation-response.schema.json",
  "title": "EducationalPackageGenerationResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "generationId", "mode", "generatedAt", "title", "generalObjective", "preset", "requestedMaterials", "materials"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "generationId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["mock", "live"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1 },
    "generalObjective": { "type": "string", "minLength": 1 },
    "preset": { "enum": ["class_session", "workshop", "assessment", "review", "custom"] },
    "requestedMaterials": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/materialId" } },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profileId", "profileName", "generationId", "version", "status", "adaptationSummary", "artifacts"],
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "profileName": { "type": "string", "minLength": 1 },
          "generationId": { "type": "string", "minLength": 1 },
          "version": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["generated", "needs_revision", "approved"] },
          "adaptationSummary": { "type": "string", "minLength": 1 },
          "artifacts": { "$ref": "generation-request.schema.json#/$defs/artifacts" }
        }
      }
    }
  },
  "$defs": {
    "materialId": {
      "enum": ["explanation", "summary", "activity", "workshop", "exercises", "quiz", "short_assessment", "answer_key", "evaluation_criteria", "rubric", "teacher_guide"]
    }
  }
}
