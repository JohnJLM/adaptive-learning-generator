{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-learning-generator.local/schemas/finalization-request.schema.json",
  "title": "FinalizationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "generationId", "profileCount", "iterationCount", "approvedProfileIds"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "generationId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "profileCount": { "type": "integer", "minimum": 1, "maximum": 6 },
    "iterationCount": { "type": "integer", "minimum": 0, "maximum": 10 },
    "approvedProfileIds": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
  }
}
