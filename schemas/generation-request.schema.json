{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-learning-generator.local/schemas/generation-request.schema.json",
  "title": "EducationalPackageGenerationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "subject",
    "topic",
    "generalObjective",
    "durationMinutes",
    "preset",
    "requestedMaterials",
    "sourceContext",
    "generalInstructions",
    "profiles"
  ],
  "properties": {
    "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "topicKey": { "enum": ["genetics", "motion"] },
    "topic": { "type": "string", "minLength": 1, "maxLength": 300 },
    "generalObjective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "durationMinutes": { "type": "integer", "minimum": 5, "maximum": 180 },
    "preset": { "enum": ["class_session", "workshop", "assessment", "review", "custom"] },
    "requestedMaterials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/materialId" }
    },
    "sourceContext": { "type": "string", "maxLength": 12000 },
    "generalInstructions": { "type": "string", "maxLength": 3000 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/profile" }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousGenerationId", "globalFeedback", "profiles"],
      "properties": {
        "previousGenerationId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "globalFeedback": { "type": "string", "maxLength": 2000 },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profileId", "previousVersion", "feedback", "previousArtifacts"],
            "properties": {
              "profileId": { "type": "string", "minLength": 1, "maxLength": 100 },
              "previousVersion": { "type": "integer", "minimum": 1 },
              "feedback": { "type": "string", "maxLength": 2000 },
              "previousArtifacts": { "$ref": "#/$defs/artifacts" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "materialId": {
      "enum": [
        "explanation",
        "summary",
        "activity",
        "workshop",
        "exercises",
        "quiz",
        "short_assessment",
        "answer_key",
        "evaluation_criteria",
        "rubric",
        "teacher_guide"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "course",
        "knowledgeLevel",
        "priorKnowledge",
        "specificObjective",
        "expectedComplexity",
        "accessibilitySupportIds",
        "considerations",
        "additionalInstructions"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "course": { "type": "string", "minLength": 1, "maxLength": 200 },
        "knowledgeLevel": { "type": "string", "minLength": 1, "maxLength": 300 },
        "priorKnowledge": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "specificObjective": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "expectedComplexity": { "enum": ["introductory", "intermediate", "advanced"] },
        "accessibilitySupportIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "plain_language",
              "reading_support",
              "visual_access",
              "hearing_access",
              "motor_keyboard_access",
              "executive_function_support",
              "multiple_expression_options"
            ]
          }
        },
        "considerations": { "type": "string", "maxLength": 2000 },
        "additionalInstructions": { "type": "string", "maxLength": 2000 }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "explanation": { "$ref": "#/$defs/explanation" },
        "summary": { "$ref": "#/$defs/summary" },
        "activity": { "$ref": "#/$defs/activity" },
        "workshop": { "$ref": "#/$defs/activity" },
        "exercises": { "$ref": "#/$defs/questionSet" },
        "quiz": { "$ref": "#/$defs/questionSet" },
        "short_assessment": { "$ref": "#/$defs/questionSet" },
        "answer_key": { "$ref": "#/$defs/answerKey" },
        "evaluation_criteria": { "$ref": "#/$defs/evaluationCriteria" },
        "rubric": { "$ref": "#/$defs/rubric" },
        "teacher_guide": { "$ref": "#/$defs/teacherGuide" }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "introduction", "sections"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "introduction": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/textSection" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "content"],
      "properties": { "title": { "type": "string", "minLength": 1 }, "content": { "type": "string", "minLength": 1 } }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "instructions", "expectedEvidence", "estimatedMinutes"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "instructions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "expectedEvidence": { "type": "string", "minLength": 1 },
        "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 180 }
      }
    },
    "questionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "instructions", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
      }
    },
    "answerKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/answer" } }
      }
    },
    "evaluationCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "criteria"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "evidenceExpected", "criteria"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "evidenceExpected": { "type": "string", "minLength": 1 },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rubricCriterion" } }
      }
    },
    "teacherGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "overview", "sequence", "reviewNotes"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "overview": { "type": "string", "minLength": 1 },
        "sequence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/guideStep" } },
        "reviewNotes": { "type": "string", "minLength": 1 }
      }
    },
    "textSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "content"],
      "properties": { "heading": { "type": "string", "minLength": 1 }, "content": { "type": "string", "minLength": 1 } }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "prompt": { "type": "string", "minLength": 1 } }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "answer", "rationale"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "description"],
      "properties": { "criterion": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } }
    },
    "rubricCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "description", "levels"],
      "properties": {
        "criterion": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "levels": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/rubricLevel" } }
      }
    },
    "rubricLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description"],
      "properties": { "label": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } }
    },
    "guideStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "description"],
      "properties": { "step": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } }
    }
  }
}
